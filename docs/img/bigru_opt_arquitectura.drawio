    <!-- ===== NOTA CLAVE: MASK-THEN-CONCATENATE ===== -->
    <mxCell id="note_mask" value="&lt;b&gt;mask-then-concatenate:&lt;/b&gt;&lt;br/&gt;x̃&lt;sub&gt;t&lt;/sub&gt; = [x&lt;sub&gt;t&lt;/sub&gt; ‖ m&lt;sub&gt;t&lt;/sub&gt;]&lt;br/&gt;x&lt;sub&gt;t&lt;/sub&gt; ∈ ℝ⁴ (valores)&lt;br/&gt;m&lt;sub&gt;t&lt;/sub&gt; ∈ {0,1}⁴ (máscara)&lt;br/&gt;→ x̃&lt;sub&gt;t&lt;/sub&gt; ∈ ℝ⁸" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
      <mxGeometry x="1020" y="85" width="190" height="110" as="geometry" />
    </mxCell>
    <mxCell id="note_gru_eq" value="&lt;b&gt;Ecuaciones GRU:&lt;/b&gt;&lt;br/&gt;r&lt;sub&gt;t&lt;/sub&gt; = σ(W&lt;sub&gt;r&lt;/sub&gt;x̃&lt;sub&gt;t&lt;/sub&gt; + U&lt;sub&gt;r&lt;/sub&gt;h&lt;sub&gt;t-1&lt;/sub&gt;)&lt;br/&gt;z&lt;sub&gt;t&lt;/sub&gt; = σ(W&lt;sub&gt;z&lt;/sub&gt;x̃&lt;sub&gt;t&lt;/sub&gt; + U&lt;sub&gt;z&lt;/sub&gt;h&lt;sub&gt;t-1&lt;/sub&gt;)&lt;br/&gt;h̃&lt;sub&gt;t&lt;/sub&gt; = tanh(W&lt;sub&gt;h&lt;/sub&gt;x̃&lt;sub&gt;t&lt;/sub&gt; + U&lt;sub&gt;h&lt;/sub&gt;(r&lt;sub&gt;t&lt;/sub&gt;⊙h&lt;sub&gt;t-1&lt;/sub&gt;))&lt;br/&gt;h&lt;sub&gt;t&lt;/sub&gt; = (1-z&lt;sub&gt;t&lt;/sub&gt;)⊙h&lt;sub&gt;t-1&lt;/sub&gt; + z&lt;sub&gt;t&lt;/sub&gt;⊙h̃&lt;sub&gt;t&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
      <mxGeometry x="1220" y="85" width="250" height="120" as="geometry" />
    </mxCell>
    <mxCell id="note_concat" value="&lt;b&gt;Bidireccional:&lt;/b&gt;&lt;br/&gt;h&lt;sup&gt;(bi)&lt;/sup&gt;&lt;sub&gt;t&lt;/sub&gt; = [h⃗&lt;sub&gt;t&lt;/sub&gt; ‖ h⃖&lt;sub&gt;t&lt;/sub&gt;]&lt;br/&gt;∈ ℝ&lt;sup&gt;128+128&lt;/sup&gt; = ℝ²⁵⁶&lt;br/&gt;(contexto pasado + futuro)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
      <mxGeometry x="1020" y="235" width="200" height="90" as="geometry" />
    </mxCell>

